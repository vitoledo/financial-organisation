# supercronic crontab — schedules the syncs twice a day, every day.
# Times are local (America/Sao_Paulo), set via CRON_TZ + the TZ env var.
CRON_TZ=America/Sao_Paulo

# Pierre → SQLite → Notion, todos os dias às 06:40 e 18:40 (horário de Brasília):
# Transações, Faturas, Contas e Log de Sincronização.
# Requer as variáveis NOTION_* e o data/account-mapping.json; sem elas falha rápido e não grava nada.
40 6,18 * * * node /app/dist/notion/sync/cli.js --apply

# Planilha Google Sheets (legado): só roda com ENABLE_GOOGLE_SHEETS_SYNC=true no .env
# (e os tokens do Google em data/google-tokens.json).
30 6,18 * * * if [ "$ENABLE_GOOGLE_SHEETS_SYNC" = "true" ]; then node /app/dist/index.js; fi

{
  "name": "financial-organisation",
  "version": "1.0.0",
  "description": "Automated financial spreadsheet — pulls data from Pierre API, stores in SQLite, renders to Google Sheets",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "sync": "ts-node src/index.ts",
    "sync:full": "ts-node src/index.ts --full",
    "sync:dry": "ts-node src/index.ts --dry-run",
    "setup": "ts-node src/index.ts --setup-only",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "finance",
    "open-finance",
    "pierre",
    "google-sheets",
    "automation"
  ],
  "author": "",
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^4.1.9",
    "typescript": "^5.8.0",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "better-sqlite3": "^11.9.0",
    "commander": "^13.1.0",
    "dotenv": "^16.5.0",
    "google-auth-library": "^10.9.0",
    "googleapis": "^148.0.0",
    "open": "^10.1.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "ts-node": "^10.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}

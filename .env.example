# === Pierre API ===
PIERRE_API_KEY=your_pierre_api_key_here
# Optional: override the Pierre base URL (defaults to https://api.pierre.com.br)
# PIERRE_API_URL=

# === Google OAuth2 ===
# Create credentials at: https://console.cloud.google.com/apis/credentials
# IMPORTANT: publish the OAuth consent screen to "Production". While it is in
# "Testing", Google expires the refresh token after 7 days and the unattended
# sync breaks roughly every week.
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# === Spreadsheet ===
# Leave empty for auto-creation on first run.
# After first run, the ID is saved to data/spreadsheet-id.txt
SPREADSHEET_ID=

# === Runtime (optional, defaults shown) ===
# HEADLESS=0        # 1 = never open a browser (set automatically in Docker)
# LOG_TO_FILE=1     # 0 = stdout only (set to 0 in Docker; the daemon rotates logs)
# STALE_HOURS=30    # heartbeat age (h) before the container healthcheck fails
# DATA_DIR=./data   # base dir for db, tokens, logs, spreadsheet-id, heartbeat

# === Paths (optional, override DATA_DIR-derived defaults) ===
# DB_PATH=./data/financial.db
# LOG_PATH=./data/sync.log
# TOKENS_PATH=./data/google-tokens.json

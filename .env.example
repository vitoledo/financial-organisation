# === Pierre API ===
PIERRE_API_KEY=your_pierre_api_key_here
# Defaults to https://www.pierre.finance/tools/api
# PIERRE_API_URL=https://www.pierre.finance/tools/api

# === Notion Integration (Modern Data Sources API) ===
# Token da integração interna do Notion (Notion-Version: 2026-03-11)
NOTION_API_KEY=secret_notion_integration_token_here

# Identificadores das 12 Data Sources existentes no workspace
NOTION_DS_ACCOUNTS=your_accounts_data_source_id_here
NOTION_DS_TRANSACTIONS=your_transactions_data_source_id_here
NOTION_DS_CATEGORIES=your_categories_data_source_id_here
NOTION_DS_RULES=your_rules_data_source_id_here
NOTION_DS_FIXED_BILLS=your_fixed_bills_data_source_id_here
NOTION_DS_MONTHLY_OBLIGATIONS=your_obligations_data_source_id_here
NOTION_DS_INVESTMENTS=your_investments_data_source_id_here
NOTION_DS_INVESTMENT_MOVEMENTS=your_investment_movements_data_source_id_here
NOTION_DS_MONTHLY_BUDGET=your_monthly_budget_data_source_id_here
NOTION_DS_FINANCIAL_GOALS=your_goals_data_source_id_here
NOTION_DS_MONTHLY_CLOSINGS=your_monthly_closings_data_source_id_here
NOTION_DS_SYNC_LOG=your_sync_log_data_source_id_here

# 13ª Base: A ser criada pelo usuário após análise do manifesto em architecture/notion-schema-delta.md
# NOTION_DS_CARD_BILLS=your_card_bills_data_source_id_here

# === Segurança e Criptografia Privada (Storage Cifrado e HMAC PII) ===
# Chave aleatória de 256 bits em hex (64 caracteres hexadecimais) para AES-256-GCM
# Gere com: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
AUDIT_ENCRYPTION_KEY=
# Chave secreta de 256 bits para cálculo de HMAC-SHA256 de CPF/CNPJ sem expor PII no Notion
# Gere com: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
AUDIT_HMAC_SECRET_KEY=

# === Storage Técnico Privado (Opcional / Produção CI) ===
# Se usar Turso / libSQL privado para constraints de concorrência e idempotência atômica:
# PRIVATE_DB_URL=libsql://...
# PRIVATE_DB_TOKEN=...

# === Google OAuth2 (Legado - Opcional para rollback/comparação) ===
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# SPREADSHEET_ID=
# ENABLE_GOOGLE_SHEETS_SYNC=false

# === Runtime / Paths ===
# HEADLESS=1
# DATA_DIR=./data
# DB_PATH=./data/financial.db
# LOG_PATH=./data/sync.log
